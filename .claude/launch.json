{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/spa-server.py",
        "8788",
        "app"
      ],
      "port": 8788
    },
    {
      "name": "admin",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8789",
        "--directory",
        "admin"
      ],
      "port": 8789
    },
    {
      "name": "baseline",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--directory",
        ".baseline"
      ],
      "port": 8790
    }
  ]
}
